# Neon PostgreSQL (get from neon.tech)
SPRING_DATASOURCE_URL=jdbc:postgresql://<your-neon-host>/<dbname>?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# FastAPI service URL (Render URL of FastAPI)
AI_SERVICE_URL=https://recruitment-fastapi.onrender.com

# SMTP (Gmail App Password recommended)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Frontend URL (Vercel)
FRONTEND_URL=https://recruitment-frontend.vercel.app

# Auth API key shared with FastAPI
API_KEY=
